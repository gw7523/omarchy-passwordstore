check "git conflict: the pull succeeds and names the entry" '.ok == true and .conflicts == ["web/site"]' "$out"
[[ $(cat "$sb/web/site.gpg") == B-edit ]] && ok "git conflict: this seat's version stays the entry" || bad "git conflict: this seat's version stays the entry"
copies_arr=("$sb/web/site (conflict from origin, "*.gpg); copy1=${copies_arr[0]##*/}
[[ -e ${copies_arr[0]} && $(cat "$sb/web/$copy1" 2>/dev/null) == A-edit ]] && ok "git conflict: the remote's version is kept beside it" || bad "git conflict: the remote's version is kept beside it ($(ls "$sb/web"))"
[[ ! -d $sb/.git/rebase-merge && $(git -C "$sb" status --porcelain | wc -l) -eq 0 ]] && ok "git conflict: the rebase is finished and the tree clean" || bad "git conflict: the rebase is finished and the tree clean"
grep -q 'changed on both seats' "$work/notify.calls" && ok "git conflict: the user is told" || bad "git conflict: the user is told"
# A second conflict on the same entry: the first copy is not overwritten.
git -C "$sb" push -q 2>/dev/null
git -C "$sa" pull -q --rebase 2>/dev/null; printf 'A-edit-2\n' > "$sa/web/site.gpg"; git -C "$sa" commit -qam "A edits site again"; git -C "$sa" push -q
printf 'B-edit-2\n' > "$sb/web/site.gpg"; git -C "$sb" commit -qam "B edits site again"
out=$("$SETUP" sync-pull --store "$sb" --backend git)
copies_arr=("$sb/web/site (conflict from origin, "*.gpg); copies=${#copies_arr[@]}
copy2=""; for c in "${copies_arr[@]}"; do [[ ${c##*/} != "$copy1" ]] && copy2=$c; done
[[ $(jq -r '.ok' <<<"$out") == true && $copies -eq 2 && $(cat "$sb/web/$copy1") == A-edit && $(cat "$copy2" 2>/dev/null) == A-edit-2 && $(cat "$sb/web/site.gpg") == B-edit-2 ]] \
  && ok "git conflict: a second conflict gets its own copy, the first stays" || bad "git conflict: a second conflict gets its own copy, the first stays ($copies copies; $out)"
# The other seat pulls those copies: it is told, and nothing is a conflict there.
git -C "$sb" push -q
out=$("$SETUP" sync-pull --store "$sa" --backend git)
check "git conflict: the seat a copy arrives at is told about it" '.ok == true and (.conflicts | length) == 1 and (.conflicts[0] | test("conflict from origin"))' "$out"
# .gpg-id changed on both: this seat's stays, and no fake entry appears.
printf '%s\n' "$ALICE" "$BOB" > "$sa/.gpg-id"; git -C "$sa" commit -qam "A adds bob"; git -C "$sa" push -q
printf '%s\n' "$ALICE" "carol@example.com" > "$sb/.gpg-id"; git -C "$sb" commit -qam "B adds carol"
