[[ $(jq -r '.ok' <<<"$out") == true && $(cat "$sb/.gpg-id") == "$ALICE"$'\n'"carol@example.com" && ! -e ${gid_copies[0]} ]] \
  && ok "git conflict: .gpg-id keeps this seat's version and gains no .gpg copy" || bad "git conflict: .gpg-id keeps this seat's version and gains no .gpg copy ($out)"
git -C "$sb" push -q; git -C "$sa" pull -q --rebase 2>/dev/null
# Deleted there, edited here: this seat's stays, and the note says so.
