printf 'B-edit-3\n' > "$sb/web/site.gpg"; git -C "$sb" commit -qam "B edits site a third time"
out=$("$SETUP" sync-pull --store "$sb" --backend git)
[[ $(jq -r '.ok' <<<"$out") == true && $(cat "$sb/web/site.gpg") == B-edit-3 && $(jq -r '.conflicts[0]' <<<"$out") == *"deleted on the other seat"* ]] \
  && ok "git conflict: an entry deleted there and edited here is kept, and the note says why" || bad "git conflict: an entry deleted there and edited here is kept, and the note says why ($out)"

out=$("$SETUP" history --store "$sb" --entry web/site)
check "history: lists the entry's commits, newest first, with author and subject" '.entry == "web/site" and (.commits | length) >= 3 and (.commits[0].author | length) > 0 and (.commits | map(.subject) | index("base") != null) and (.commits[0].date | test("^20"))' "$out"
base_sha=$(jq -r '.commits[] | select(.subject == "base") | .sha' <<<"$out")
out=$("$SETUP" restore --store "$sb" --entry web/site --sha "$base_sha")
check "restore: reports ok" '.ok == true and .entry == "web/site"' "$out"
[[ $(cat "$sb/web/site.gpg") == v0 && $(git -C "$sb" log -1 --format=%s) == "Restore web/site from ${base_sha:0:7}." ]] \
  && ok "restore: the file is back as it was, as a new commit" || bad "restore: the file is back as it was, as a new commit"
out=$("$SETUP" restore --store "$sb" --entry web/site --sha deadbeef)
check "restore: an unknown version is an error" '.ok != true' "$out"
"$SETUP" history --store "$sb" --entry ../x >/dev/null 2>&1; [[ $? -eq 2 ]] && ok "history refuses a traversal name" || bad "history refuses a traversal name"
"$SETUP" history --store "$sb" --entry 'web/*' >/dev/null 2>&1; [[ $? -eq 2 ]] && ok "history refuses a glob name" || bad "history refuses a glob name"
# Renamed (pass mv is a git mv): the history follows, the rename commit
# itself restores, and a version from before the rename restores under
# the new name, into a directory that is gone.
git -C "$sb" mv web/site.gpg web/moved.gpg; git -C "$sb" commit -qm "B renames site"
out=$("$SETUP" history --store "$sb" --entry web/moved)
check "history: follows a rename" '(.commits | map(.subject) | index("base")) != null' "$out"
rename_sha=$(jq -r '.commits[] | select(.subject == "B renames site") | .sha' <<<"$out")
printf 'later\n' > "$sb/web/moved.gpg"; git -C "$sb" commit -qam "B edits moved"
out=$("$SETUP" restore --store "$sb" --entry web/moved --sha "${rename_sha:0:7}")
[[ $(jq -r .ok <<<"$out") == true && $(cat "$sb/web/moved.gpg") == v0 ]] && ok "restore: the rename commit itself, by a short sha" || bad "restore: the rename commit itself, by a short sha ($out)"
rm -rf "$sb/web"; git -C "$sb" commit -qam "B removes web"
out=$("$SETUP" restore --store "$sb" --entry web/moved --sha "$base_sha")
[[ $(jq -r .ok <<<"$out") == true && $(cat "$sb/web/moved.gpg" 2>/dev/null) == v0 ]] && ok "restore: a pre-rename version lands under the new name, parent made" || bad "restore: a pre-rename version lands under the new name, parent made ($out)"

# Signed commits: a vault with gitSign gets commit.gpgsign and the store's key as signingkey.
cp "$XDG_CONFIG_HOME/omarchy/shell.json" "$work/shell.json.keep"
write_shell_json '{"vaults": [{"id": "personal", "name": "Personal", "gitSign": true}], "activeVaultId": "personal"}'
s5="$work/store5"; mkdir -p "$s5/web"; printf '%s\n' "$ALICE" > "$s5/.gpg-id"; : > "$s5/web/site.gpg"
remote_e="$work/remote-e.git"; git init -q --bare -b main "$remote_e"
"$SETUP" sync-setup --store "$s5" --vault personal --backend git --git-remote "file://$remote_e" >/dev/null
[[ $(git -C "$s5" config commit.gpgsign) == true && $(git -C "$s5" config user.signingkey) == "$ALICE" ]] \
  && ok "gitSign: sync-setup turns on signed commits with the store's key" || bad "gitSign: sync-setup turns on signed commits with the store's key"
write_shell_json '{"vaults": [{"id": "personal", "name": "Personal", "gitSign": false}], "activeVaultId": "personal"}'
"$SETUP" sync-setup --store "$s5" --vault personal --backend git --git-remote "file://$remote_e" >/dev/null
[[ -z $(git -C "$s5" config commit.gpgsign) && -z $(git -C "$s5" config user.signingkey) ]] && ok "gitSign off: sync-setup removes it again" || bad "gitSign off: sync-setup removes it again"
# A shared vault whose first id is not ours: the signing key is the one with a secret part here.
write_shell_json '{"vaults": [{"id": "personal", "name": "Personal", "gitSign": true}], "activeVaultId": "personal"}'
printf '%s\n' "# team" "carol@example.com" "$ALICE" > "$s5/.gpg-id"
"$SETUP" sync-setup --store "$s5" --vault personal --backend git --git-remote "file://$remote_e" >/dev/null 2>&1
[[ $(git -C "$s5" config user.signingkey) == "$ALICE" ]] && ok "gitSign: picks the id with a secret key here, past comments and others' keys" || bad "gitSign: picks the id with a secret key here, past comments and others' keys ($(git -C "$s5" config user.signingkey))"
printf '%s\n' "carol@example.com" > "$s5/.gpg-id"
"$SETUP" sync-setup --store "$s5" --vault personal --backend git --git-remote "file://$remote_e" >/dev/null 2>&1
[[ -z $(git -C "$s5" config commit.gpgsign) && -z $(git -C "$s5" config user.signingkey) ]] && ok "gitSign: no signable key means no gpgsign and no signingkey" || bad "gitSign: no signable key means no gpgsign and no signingkey"
cp "$work/shell.json.keep" "$XDG_CONFIG_HOME/omarchy/shell.json"

# --- pinentry ---------------------------------------------------------------

export GNUPGHOME="$work/gnupg"; mkdir -p "$GNUPGHOME"
printf '#!/bin/bash\nprintf "%%s\\n" "$*" >> "$WORK/gpgconf.calls"\n' > "$work/bin/gpgconf"; chmod +x "$work/bin/gpgconf"
printf 'default-cache-ttl 600\n' > "$GNUPGHOME/gpg-agent.conf"
out=$("$SETUP" pinentry)
check "pinentry: reports default when gpg-agent.conf names no program" '.ok == true and .pinentry == "default"' "$out"
out=$("$SETUP" pinentry --enable)
check "pinentry --enable: reports omarchy" '.ok == true and .pinentry == "omarchy"' "$out"
grep -q '^pinentry-program .*/pinentry-omarchy$' "$GNUPGHOME/gpg-agent.conf" && grep -qx 'default-cache-ttl 600' "$GNUPGHOME/gpg-agent.conf" \
  && ok "pinentry --enable: writes the line and keeps the rest of gpg-agent.conf" \
  || bad "pinentry --enable: writes the line and keeps the rest of gpg-agent.conf"
grep -qx -- '--reload gpg-agent' "$work/gpgconf.calls" && ok "pinentry --enable: reloads the agent" || bad "pinentry --enable: reloads the agent"
[[ $(stat -c %a "$GNUPGHOME/gpg-agent.conf") == 600 ]] && ok "pinentry: the conf stays private (600)" || bad "pinentry: the conf stays private (600)"
printf 'pinentry-program /usr/bin/pinentry-qt\n' > "$GNUPGHOME/gpg-agent.conf"
out=$("$SETUP" pinentry)
check "pinentry: another program reports other" '.pinentry == "other"' "$out"
out=$("$SETUP" pinentry --disable)
check "pinentry --disable: back to default" '.pinentry == "default"' "$out"
grep -q pinentry-program "$GNUPGHOME/gpg-agent.conf" && bad "pinentry --disable: drops the line" || ok "pinentry --disable: drops the line"
unset GNUPGHOME

# --- lockout policy ---------------------------------------------------------

export XDG_RUNTIME_DIR="$work/run2"; mkdir -p "$XDG_RUNTIME_DIR"
out=$("$SETUP" lockout-policy --vault personal)
check "lockout-policy: defaults when the settings are unset" '.ok == true and .policy.attempts == 5 and .policy.lockoutSec == 30 and .policy.lockSession == false' "$out"
jq '(.bar.layout.right[0]) += {unlockAttempts: 3, unlockLockoutSec: 10, lockSessionOnLockout: true}' "$XDG_CONFIG_HOME/omarchy/shell.json" > "$work/sj" && mv "$work/sj" "$XDG_CONFIG_HOME/omarchy/shell.json"
out=$("$SETUP" lockout-policy --vault personal)
check "lockout-policy: takes the entry's settings" '.policy.attempts == 3 and .policy.lockoutSec == 10 and .policy.lockSession == true' "$out"
[[ $(jq -r .attempts "$XDG_RUNTIME_DIR/pinentry-omarchy/policy.json") == 3 ]] && ok "lockout-policy: pinentry-omarchy has it" || bad "lockout-policy: pinentry-omarchy has it"
export GNUPGHOME="$work/gnupg2"; mkdir -p "$GNUPGHOME"; printf 'default-cache-ttl 600\n' > "$GNUPGHOME/gpg-agent.conf"
out=$("$SETUP" lockout-policy --vault personal)
grep -q 'no-allow-loopback-pinentry' "$GNUPGHOME/gpg-agent.conf" && bad "lockout-policy: loopback is left alone by default" || ok "lockout-policy: loopback is left alone by default"
jq '(.bar.layout.right[0]) += {lockoutNoLoopback: true}' "$XDG_CONFIG_HOME/omarchy/shell.json" > "$work/sj" && mv "$work/sj" "$XDG_CONFIG_HOME/omarchy/shell.json"
out=$("$SETUP" lockout-policy --vault personal)
check "lockout-policy: reports noLoopback" '.policy.noLoopback == true' "$out"
grep -qx 'no-allow-loopback-pinentry' "$GNUPGHOME/gpg-agent.conf" && grep -qx 'default-cache-ttl 600' "$GNUPGHOME/gpg-agent.conf" \
  && ok "lockout-policy: writes no-allow-loopback-pinentry and keeps the rest" || bad "lockout-policy: writes no-allow-loopback-pinentry and keeps the rest"
reloads=$(grep -c -- '--reload gpg-agent' "$work/gpgconf.calls")
"$SETUP" lockout-policy --vault personal >/dev/null
[[ $(grep -c -- '--reload gpg-agent' "$work/gpgconf.calls") == "$reloads" ]] && ok "lockout-policy: no reload (no cache flush) when the line already matches" \
  || bad "lockout-policy: no reload (no cache flush) when the line already matches"
printf 'allow-loopback-pinentry\nno-allow-loopback-pinentry\nallow-loopback-pinentry\n' > "$GNUPGHOME/gpg-agent.conf"
"$SETUP" lockout-policy --vault personal >/dev/null
[[ $(grep -E 'allow-loopback-pinentry' "$GNUPGHOME/gpg-agent.conf" | tail -n1) == no-allow-loopback-pinentry && $(grep -c 'allow-loopback' "$GNUPGHOME/gpg-agent.conf") == 1 ]] \
  && ok "lockout-policy: an allow line after the refusal (gpg takes the last) is removed too" \
  || bad "lockout-policy: an allow line after the refusal (gpg takes the last) is removed too"
jq '(.bar.layout.right[0]) += {lockoutNoLoopback: false}' "$XDG_CONFIG_HOME/omarchy/shell.json" > "$work/sj" && mv "$work/sj" "$XDG_CONFIG_HOME/omarchy/shell.json"
"$SETUP" lockout-policy --vault personal >/dev/null
grep -q 'no-allow-loopback-pinentry' "$GNUPGHOME/gpg-agent.conf" && bad "lockout-policy: turning it off removes the line" || ok "lockout-policy: turning it off removes the line"
ln -sfn "$GNUPGHOME/real.conf" "$GNUPGHOME/gpg-agent.conf"; printf 'default-cache-ttl 600\n' > "$GNUPGHOME/real.conf"
jq '(.bar.layout.right[0]) += {lockoutNoLoopback: true}' "$XDG_CONFIG_HOME/omarchy/shell.json" > "$work/sj" && mv "$work/sj" "$XDG_CONFIG_HOME/omarchy/shell.json"
"$SETUP" lockout-policy --vault personal >/dev/null
[[ -L $GNUPGHOME/gpg-agent.conf ]] && grep -qx 'no-allow-loopback-pinentry' "$GNUPGHOME/real.conf" && ok "lockout-policy: writes through a symlinked conf" \
  || bad "lockout-policy: writes through a symlinked conf"
unset GNUPGHOME
out=$("$SETUP" status --vault personal)
check "status: reports the lockout" '.lockout.locked == false and .lockout.attempts == 3' "$out"
unset XDG_RUNTIME_DIR

echo
printf '%d passed, %d failed\n' "$passed" "$failed"
(( failed == 0 ))
