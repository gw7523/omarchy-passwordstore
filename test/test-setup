git -C "$sa" init -q -b main; git -C "$sa" config user.email a@example.invalid; git -C "$sa" config user.name A
git -C "$sa" add -A; git -C "$sa" commit -q -m base; git -C "$sa" remote add origin "$remote_d"; git -C "$sa" push -q -u origin main
rm -rf "$sb"; git clone -q "$remote_d" "$sb"; git -C "$sb" config user.email b@example.invalid; git -C "$sb" config user.name B
printf 'A-edit\n' > "$sa/web/site.gpg"; git -C "$sa" commit -qam "A edits site"; git -C "$sa" push -q
printf 'B-edit\n' > "$sb/web/site.gpg"; git -C "$sb" commit -qam "B edits site"
